{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/trigger",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 13,23 * * *"
    }
  ]
}
